+
+export function sourceMemberPath(member: string): string | undefined {
+	if (member.includes("\\") || member.includes("\0") || member.startsWith("/"))
+		throw new Error(`Unsafe source archive path: ${member}`);
+	const parts = member.replace(/\/$/, "").split("/");
+	if (
+		parts.length < 1 ||
+		parts.some(
+			part =>
+				!part ||
+				part === "." ||
+				part === ".." ||
+				/[:\x00-\x1f]/.test(part) ||
+				/[. ]$/.test(part) ||
+				/^(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\.|$)/i.test(part) ||
+				part.toLowerCase() === ".git",
+		)
+	) {
+		throw new Error(`Unsafe source archive path: ${member}`);
+	}
+	return parts.length === 1 || member.endsWith("/") ? undefined : parts.slice(1).join("/");
+}
+
+export async function exportSourceArchive(bytes: Uint8Array, candidate: string): Promise<void> {
+	const files = await new Bun.Archive(bytes).files();
+	if (files.size === 0) throw new Error("Source archive is empty");
