diff --git a/packages/coding-agent/test/cli/localized-update.test.ts b/packages/coding-agent/test/cli/localized-update.test.ts
new file mode 100644
index 0000000..0ab605f
--- /dev/null
+++ b/packages/coding-agent/test/cli/localized-update.test.ts
@@ -0,0 +1,226 @@
+import { afterEach, describe, expect, it } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import { pathToFileURL } from "node:url";
+import { removeWithRetries } from "@oh-my-pi/pi-utils";
+
+const original = "Korean executable must never be replaced by an official English build\n";
+const moduleUrl = pathToFileURL(path.resolve(import.meta.dir, "../../src/cli/localized-update.ts")).href;
+const bunPath = process.execPath;
+
+interface Scenario {
+	portable?: boolean;
+	repeated?: boolean;
+	check?: boolean;
+	channel?: "canary";
+	sourceExit?: number;
+	version?: string;
+	missingKit?: boolean;
+	missingFile?: string;
+	spawnFailure?: boolean;
+	legacySource?: boolean;
+	force?: boolean;
+}
+
+interface Result {
+	dir: string;
+	target: string;
+	metadataPath: string;
+	metadata: string;
+	requests: string[];
+	spawned: string[][];
+	error?: string;
+	handled?: boolean;
+	exitCode: number;
+	output: string;
+}
+
+// Child isolation keeps execPath, fetch and spawn stubs away from other test files.
+describe("localized updates retain the Korean installation", () => {
+	const dirs: string[] = [];
+	afterEach(async () => {
+		await Promise.all(dirs.splice(0).map(dir => removeWithRetries(dir)));
+	});
+
+	async function run(scenario: Scenario = {}): Promise<Result> {
+		const dir = await fs.realpath(await fs.mkdtemp(path.join(os.tmpdir(), "omp-localized-update-")));
+		dirs.push(dir);
+		const target = path.join(dir, process.platform === "win32" ? "omp.exe" : "omp");
+		const metadataPath = path.join(dir, scenario.repeated ? "omp-portable-update.json" : "omp-localized.json");
+		const resultPath = path.join(dir, "result.json");
+		const metadata = JSON.stringify({
+			schemaVersion: 1,
+			bunPath,
+			repoRoot: dir,
+			executablePath: target,
+			version: "18.13.0",
+		});
+		await fs.writeFile(target, original);
+		if (!scenario.portable || scenario.repeated) await fs.writeFile(metadataPath, metadata);
+		if (scenario.legacySource) {
+			await fs.mkdir(path.join(dir, "scripts"), { recursive: true });
+			await fs.writeFile(path.join(dir, "scripts/update-localized.ts"), "// source updater");
+		}
+		if (!scenario.missingKit && !scenario.legacySource) {
+			const kit = path.join(dir, "update");
+			await fs.mkdir(path.join(kit, "scripts"), { recursive: true });
+			for (const name of [
+				process.platform === "win32" ? "bun.exe" : "bun",
+				"update-localized.js",
+				"reference.json",
+				"scripts/build-localized.ts",
+				"scripts/update-localized.ts",
+				"scripts/reapply-localization.ts",
+				"scripts/localized-update.ts",
+			]) {
+				if (name !== scenario.missingFile) await fs.writeFile(path.join(kit, name), "fixture");
+			}
+		}
+		const harness = path.join(dir, "harness.ts");
+		await fs.writeFile(
+			harness,
+			`import { runLocalizedUpdate } from ${JSON.stringify(moduleUrl)};
+const requests = [];
+const spawned = [];
+const fetchStub = async input => {
+ const url = String(input); requests.push(url);
+ if (url === "https://api.github.com/repos/can1357/oh-my-pi/releases/latest") return Response.json({tag_name: ${JSON.stringify(`v${scenario.version ?? "999.0.0"}`)}});
+ throw new Error("Official English download is forbidden: " + url);
+};
+globalThis.fetch = Object.assign(fetchStub, {preconnect: globalThis.fetch.preconnect});
+Bun.spawn = (args) => { spawned.push(args); ${scenario.spawnFailure ? 'throw new Error("runtime could not start");' : `return { exited: Promise.resolve(${scenario.sourceExit ?? 0}) };`} };
+Object.defineProperty(process, "execPath", {value: ${JSON.stringify(target)}, configurable: true});
+let error;
+let handled;
+try { handled = await runLocalizedUpdate(${JSON.stringify({ force: scenario.force ?? false, check: scenario.check ?? false, ...(scenario.channel ? { channel: scenario.channel } : {}) })}, "18.13.0"); }
+catch (caught) { error = String(caught); process.exitCode = 1; }
+await Bun.write(${JSON.stringify(resultPath)}, JSON.stringify({requests, spawned, error, handled}));
+`,
+		);
+		const child = Bun.spawn([bunPath, harness], {
+			cwd: dir,
+			env: { ...process.env, OMP_LANGUAGE_PACK_BUILD: "true" },
+			stdin: "ignore",
+			stdout: "pipe",
+			stderr: "pipe",
+		});
+		const [stdout, stderr, exitCode] = await Promise.all([
+			new Response(child.stdout).text(),
+			new Response(child.stderr).text(),
+			child.exited,
+		]);
+		expect(await Bun.file(resultPath).exists(), `${stdout}\n${stderr}`).toBe(true);
+		const result = (await Bun.file(resultPath).json()) as Pick<Result, "requests" | "spawned" | "error" | "handled">;
+		return { ...result, dir, target, metadataPath, metadata, exitCode, output: stdout + stderr };
+	}
+
+	async function expectRetained(result: Result, portable: boolean) {
+		expect(await fs.readFile(result.target, "utf8")).toBe(original);
+		if (!portable) expect(await fs.readFile(result.metadataPath, "utf8")).toBe(result.metadata);
+		else expect(await Bun.file(result.metadataPath).exists()).toBe(false);
+	}
+
+	for (const portable of [false, true]) {
+		it(`runs the packaged source updater for ${portable ? "portable" : "metadata-backed"} installations`, async () => {
+			const result = await run({ portable, force: true });
+			expect(result.exitCode).toBe(0);
+			expect(result.handled).toBe(true);
+			expect(result.requests).toEqual([]);
+			expect(result.spawned).toHaveLength(1);
+			const args = result.spawned[0]!;
+			expect(args[0]).toBe(path.join(result.dir, "update", process.platform === "win32" ? "bun.exe" : "bun"));
+			expect(args[1]).toBe(path.join(result.dir, "update/update-localized.js"));
+			expect(args).toContain("--force");
+			expect(args).toContain(portable ? "--portable-executable" : "--metadata");
+			if (portable) expect(args).toContain("--installed-version");
+			await expectRetained(result, portable);
+		});
+
+		for (const sourceExit of [1, 42]) {
+			it(`never fetches an official build after updater exit ${sourceExit} (${portable ? "portable" : "source"})`, async () => {
+				const result = await run({ portable, sourceExit });
+				expect(result.exitCode).toBe(1);
+				expect(result.error).toContain("Korean installation was retained");
+				expect(result.requests).toEqual([]);
+				expect(result.spawned).toHaveLength(1);
+				await expectRetained(result, portable);
+			});
+		}
+
+		it(`checks upstream without a runtime or kit and does not mutate ${portable ? "portable" : "source"} installs`, async () => {
+			const result = await run({ portable, check: true, missingKit: true });
+			expect(result.exitCode).toBe(0);
+			expect(result.handled).toBe(true);
+			expect(result.requests).toEqual(["https://api.github.com/repos/can1357/oh-my-pi/releases/latest"]);
+			expect(result.spawned).toEqual([]);
+			expect(result.output).toContain("upstream stable: 999.0.0");
+			expect(await Bun.file(path.join(result.dir, "update/bun.exe")).exists()).toBe(false);
+			await expectRetained(result, portable);
+		});
+
+		it(`rejects canary before network or spawning (${portable ? "portable" : "source"})`, async () => {
+			const result = await run({ portable, channel: "canary" });
+			expect(result.exitCode).toBe(1);
+			expect(result.error).toContain("stable releases only");
+			expect(result.requests).toEqual([]);
+			expect(result.spawned).toEqual([]);
+			await expectRetained(result, portable);
+		});
+	}
+
+	it("fails explicitly for a missing portable kit instead of downloading English or an unverified runtime", async () => {
+		const result = await run({ portable: true, missingKit: true });
+		expect(result.exitCode).toBe(1);
+		expect(result.error).toContain("update kit is missing");
+		expect(result.requests).toEqual([]);
+		expect(result.spawned).toEqual([]);
+		await expectRetained(result, true);
+	});
+
+	it("reuses portable transaction metadata and the bundled runtime on a second update", async () => {
+		const result = await run({ portable: true, repeated: true });
+		expect(result.exitCode).toBe(0);
+		expect(result.spawned[0]).toContain("--metadata");
+		expect(result.spawned[0]).toContain(result.metadataPath);
+		expect(result.spawned[0]).not.toContain("--portable-executable");
+		expect(await fs.readFile(result.metadataPath, "utf8")).toBe(result.metadata);
+		expect(await fs.readFile(result.target, "utf8")).toBe(original);
+	});
+
+	it("keeps the installation when bundled runtime startup fails", async () => {
+		const result = await run({ portable: true, spawnFailure: true });
+		expect(result.exitCode).toBe(1);
+		expect(result.error).toContain("runtime could not start");
+		expect(result.requests).toEqual([]);
+		await expectRetained(result, true);
+	});
+
+	it("rejects incomplete kits before spawning any updater", async () => {
+		const result = await run({ portable: true, missingFile: "scripts/reapply-localization.ts" });
+		expect(result.exitCode).toBe(1);
+		expect(result.error).toContain("update kit is incomplete");
+		expect(result.requests).toEqual([]);
+		expect(result.spawned).toEqual([]);
+		await expectRetained(result, true);
+	});
+
+	it("continues supporting developer metadata without a portable kit", async () => {
+		const result = await run({ legacySource: true });
+		expect(result.exitCode).toBe(0);
+		expect(result.spawned[0]?.slice(0, 2)).toEqual([bunPath, path.join(result.dir, "scripts/update-localized.ts")]);
+		expect(result.spawned[0]).toContain("--metadata");
+		expect(result.requests).toEqual([]);
+		await expectRetained(result, false);
+	});
+
+	for (const version of ["18.13.0", "0.0.1"]) {
+		it(`reports installed version ${version} without starting any installer`, async () => {
+			const result = await run({ portable: true, check: true, version });
+			expect(result.exitCode).toBe(0);
+			expect(result.spawned).toEqual([]);
+			expect(result.output).toContain("already up to date");
+			await expectRetained(result, true);
+		});
+	}
+});
