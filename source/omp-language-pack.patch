+console.log(JSON.stringify(globalThis.fixture.events));`,
+		);
+		return JSON.parse(
+			execFileSync(process.execPath, [resolve(directory, "harness.ts")], {
+				cwd: directory,
+				encoding: "utf8",
+				stdio: ["ignore", "pipe", "pipe"],
+			}),
+		) as string[];
+	} finally {
+		rmSync(directory, { recursive: true, force: true });
+	}
+}
