+		] as const) {
+			put(
+				file,
+				`if (globalThis.fixture.language !== "ko") throw new Error("UI consumed uninitialized locale");
+globalThis.fixture.events.push(${JSON.stringify(event)} + ":" + globalThis.fixture.language);`,
+			);
