diff --git a/packages/utils/src/i18n-browser.ts b/packages/utils/src/i18n-browser.ts
new file mode 100644
index 0000000..8f1c4a9
--- /dev/null
+++ b/packages/utils/src/i18n-browser.ts
@@ -0,0 +1,51 @@
+import { createTranslator, type Messages } from "./i18n-core";
+
+let language: "ko" | "en" = "en";
+let messages: Messages = {};
+export let t = createTranslator(messages);
+
+// pi-utils also compiles in Node hosts whose ambient document type is deliberately minimal.
+const host = globalThis as unknown as {
+	__OMP_I18N__?: unknown;
+	document?: {
+		getElementById(id: string): { textContent: string | null } | null;
+		documentElement: { lang: string };
+	};
+};
+
+/** Importing this module never reads the DOM or loads a language pack. */
+export function getLanguage(): "ko" | "en" {
+	return language;
+}
+
+export function getMessages(): Messages {
+	return messages;
+}
+
+/** Await before importing UI modules, including modules that capture translated labels. */
+export async function initializeI18n(): Promise<void> {
+	language = "en";
+	messages = {};
+	t = createTranslator(messages);
+	try {
+		const data = host.document?.getElementById("omp-i18n");
+		const selected: unknown = data ? JSON.parse(data.textContent ?? "") : host.__OMP_I18N__;
+		if (selected !== undefined) {
+			if (typeof selected !== "object" || selected === null || Array.isArray(selected)) {
+				throw new Error("Invalid browser language pack.");
+			}
+			const pack = selected as { language?: unknown; messages?: unknown };
+			if (typeof pack.language === "string" && /^ko(?:-kr)?$/i.test(pack.language)) {
+				// The host supplies validated messages; no catalog is hidden in the English bundle.
+				const next = createTranslator(pack.messages);
+				messages = pack.messages as Messages;
+				t = next;
+				language = "ko";
+			}
+		}
+	} catch {
+		// Neither rejected data nor exception details may disclose host/user secrets.
+		console.error("Could not load Korean language pack; using English.");
+	}
+	if (host.document) host.document.documentElement.lang = language;
+}
diff --git a/packages/utils/src/i18n-core.ts b/packages/utils/src/i18n-core.ts
new file mode 100644
index 0000000..d9b846d
--- /dev/null
+++ b/packages/utils/src/i18n-core.ts
@@ -0,0 +1,37 @@
+export type Messages = Readonly<Record<string, string>>;
+
+function placeholders(text: string): Set<string> {
+	return new Set(Array.from(text.matchAll(/\{(\d+)\}/g), match => match[1]));
+}
+
+/** Context distinguishes identical English messages used with different meanings. */
+export function englishSource(key: string): string {
+	const separator = key.indexOf("\u0004");
+	return separator < 0 ? key : key.slice(0, separator);
+}
+
+/** An absent message falls back to English; translated text may omit English plural suffixes. */
+export function createTranslator(messages: unknown): (source: string, ...values: string[]) => string {
+	if (typeof messages !== "object" || messages === null || Array.isArray(messages)) {
+		throw new Error("Language pack must be a JSON object mapping English messages to translations.");
+	}
+	for (const [source, translated] of Object.entries(messages)) {
+		// Arguments are dense even when English omits an earlier language-specific value.
+		const maxIndex = [...placeholders(englishSource(source))].reduce(
+			(max, index) => Math.max(max, Number(index)),
+			-1,
+		);
+		if (
+			typeof translated !== "string" ||
+			[...placeholders(translated)].some(index => !Number.isSafeInteger(Number(index)) || Number(index) > maxIndex)
+		) {
+			throw new Error(`Invalid language-pack entry (text or placeholders): ${JSON.stringify(source)}`);
+		}
+	}
+	const catalog = messages as Messages;
+	return (source, ...values) => {
+		const text = Object.hasOwn(catalog, source) ? catalog[source] : englishSource(source);
+		if (values.length === 0) return text;
+		return text.replace(/\{(\d+)\}/g, (placeholder, index: string) => values[Number(index)] ?? placeholder);
+	};
+}
