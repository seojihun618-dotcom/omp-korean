+						call =>
+							call.getExpression().getKind() === SyntaxKind.ImportKeyword &&
+							/^\.\/(?:modes\/|main(?:\.js)?$)/.test(call.getArguments()[0]?.getText().slice(1, -1) ?? ""),
+					),
+			)
+	) {
+		throw new Error("Latest CLI loads UI before the worker dispatch boundary");
+	}
+	const imports = source.getImportDeclarations().filter(declaration => declaration.getModuleSpecifierValue() === I18N);
+	const bindings = imports
+		.flatMap(declaration => declaration.getNamedImports())
+		.filter(specifier => specifier.getName() === "initializeI18n");
+	if (bindings.length > 1) throw new Error("Latest CLI has ambiguous locale initializer imports");
+	let binding = bindings[0];
+	let declaration =
+		binding?.getImportDeclaration() ??
+		imports.find(declaration => !declaration.isTypeOnly() && !declaration.getNamespaceImport());
+	if (!binding) {
+		const identifiers = new Set(
+			source.getDescendantsOfKind(SyntaxKind.Identifier).map(identifier => identifier.getText()),
+		);
+		let alias = "initializeI18n";
+		while (identifiers.has(alias)) alias = `_${alias}`;
+		if (!declaration) declaration = source.addImportDeclaration({ moduleSpecifier: I18N });
+		binding = declaration.addNamedImport({
+			name: "initializeI18n",
+			...(alias !== "initializeI18n" ? { alias } : {}),
+		});
+	}
+	if (declaration?.isTypeOnly() || binding.isTypeOnly())
+		throw new Error("Latest CLI has a type-only locale initializer import");
+	const name = binding.getAliasNode()?.getText() ?? binding.getName();
+	const calls = source
+		.getDescendantsOfKind(SyntaxKind.CallExpression)
+		.filter(call => call.getExpression().getText() === name);
+	if (calls.length) {
+		const next = handler.getStatements()[branchIndex + 1];
+		const expression = next && Node.isExpressionStatement(next) ? next.getExpression() : undefined;
+		if (
+			calls.length !== 1 ||
+			!expression ||
+			!Node.isAwaitExpression(expression) ||
+			expression.getExpression() !== calls[0] ||
+			calls[0].getArguments().length
+		) {
+			throw new Error("Latest CLI has an unsupported locale initializer placement");
+		}
+	} else {
+		handler.insertStatements(branchIndex + 1, `await ${name}();`);
+	}
+	return source.getFullText();
+}
+
+/** Safely augment latest source. Changed, ambiguous and removed call sites stay English. */
+export function applyLocalizationReference(
+	targetRoot: string,
+	reference: LocalizationReference,
+): { applied: number; skipped: number; files: number } {
+	validateReference(reference);
+	const root = resolve(targetRoot);
+	const writes = new Map<string, string>();
+	// Do not replace an upstream runtime implementation with old application code.
+	for (const [file, text] of Object.entries(reference.runtime)) {
+		const path = resolve(root, file);
+		if (existsSync(path) && readFileSync(path, "utf8") !== text)
+			throw new Error(`Latest source already owns localization runtime: ${file}`);
+		writes.set(file, text);
+	}
+	const packagePath = "packages/utils/package.json";
+	const manifest = JSON.parse(readFileSync(resolve(root, packagePath), "utf8"));
+	const exports = manifest.exports ?? {};
+	if (typeof exports !== "object" || exports === null || Array.isArray(exports))
+		throw new Error("Utils package has incompatible exports");
+	const additions = {
+		"./i18n": { browser: "./src/i18n-browser.ts", types: "./src/i18n.ts", default: "./src/i18n.ts" },
+		"./i18n-browser": { types: "./src/i18n-browser.ts", default: "./src/i18n-browser.ts" },
+	};
+	for (const [key, value] of Object.entries(additions)) {
+		if (exports[key] !== undefined && JSON.stringify(exports[key]) !== JSON.stringify(value))
+			throw new Error(`Latest source already owns utils export ${key}`);
+		exports[key] = value;
+	}
+	manifest.exports = exports;
+	writes.set(packagePath, `${JSON.stringify(manifest, null, "\t")}\n`);
+	let applied = 0;
+	let files = 0;
+	const byFile = new Map<string, Site[]>();
+	for (const site of reference.sites) byFile.set(site.file, [...(byFile.get(site.file) ?? []), site]);
+	for (const [file, sites] of byFile) {
+		const path = resolve(root, file);
+		if (!existsSync(path)) continue;
+		const source = readFileSync(path, "utf8");
+		const ast = parse(file, source);
+		const bindings = imports(ast);
+		const all = nodes(ast);
+		const candidates = new Map<string, Literal[]>();
+		for (const node of all) {
+			if (!literal(node) || !safeLiteral(node)) continue;
+			// Never translate the key or arguments of an already-localized call again.
+			let nested = false;
+			for (let parent: ts.Node | undefined = node.parent; parent; parent = parent.parent)
+				if (translated(parent, bindings)) {
+					nested = true;
+					break;
+				}
+			if (nested) continue;
+			const key = signature(node, bindings);
+			candidates.set(key, [...(candidates.get(key) ?? []), node]);
+		}
+		const selected = new Map<Literal, Site>();
+		for (const site of sites) {
+			const matches = candidates.get(JSON.stringify([site.original, site.context, site.frame]));
+			if (matches?.length === 1) selected.set(matches[0], site);
+		}
+		if (!selected.size) continue;
+		const identifiers = new Set(all.filter(ts.isIdentifier).map(node => node.text));
+		const helpers = new Map<string, string>();
+		for (const site of selected.values()) {
+			if (helpers.has(site.module)) continue;
+			let name = "__ompTranslate";
+			while (identifiers.has(name)) name = `_${name}`;
+			identifiers.add(name);
+			helpers.set(site.module, name);
+		}
+		function render(start: number, end: number, skip?: Literal): string {
+			let result = source.slice(start, end);
+			const contained = [...selected.keys()].filter(
+				node => node !== skip && node.getStart() >= start && node.end <= end,
+			);
+			const outer = contained.filter(
+				node =>
+					!contained.some(other => other !== node && other.getStart() <= node.getStart() && other.end >= node.end),
+			);
+			for (const node of outer.sort((a, b) => b.getStart() - a.getStart()))
+				result = result.slice(0, node.getStart() - start) + replacement(node) + result.slice(node.end - start);
+			return result;
+		}
+		function replacement(node: Literal): string {
+			const site = selected.get(node)!;
+			const helper = helpers.get(site.module)!;
+			let value: string;
+			if (!ts.isTemplateExpression(node)) value = `${helper}(${JSON.stringify(site.key)})`;
+			else {
+				const args = node.templateSpans.map(
+					span => `\`\${${render(span.expression.getStart(), span.expression.end)}}\``,
+				);
+				if (site.order.every((index, position) => index === position))
+					value = `${helper}(${[JSON.stringify(site.key), ...args].join(", ")})`;
+				else {
+					// Preserve original evaluation/coercion order even when reviewed placeholders moved.
+					const params = args.map((_, index) => `${helper}Value${index}`);
+					value = `((${params.join(", ")}) => ${helper}(${[JSON.stringify(site.key), ...site.order.map(index => params[index])].join(", ")}))(${args.join(", ")})`;
+				}
+			}
+			return ts.isJsxAttribute(node.parent) || ts.isJsxText(node) ? `{${value}}` : value;
+		}
+		let output = render(0, source.length);
+		const firstImport =
+			ast.statements.find(ts.isImportDeclaration)?.getStart() ??
+			(source.startsWith("#!") ? source.indexOf("\n") + 1 : 0);
+		const declarations = [...helpers]
+			.map(([module, name]) => `import { t as ${name} } from ${JSON.stringify(module)};\n`)
+			.join("");
+		output = output.slice(0, firstImport) + declarations + output.slice(firstImport);
+		writes.set(file, output);
+		applied += selected.size;
+		files++;
+	}
+	const cliPath = "packages/coding-agent/src/cli.ts";
+	const cliSource = writes.get(cliPath) ?? readFileSync(resolve(root, cliPath), "utf8");
+	writes.set(cliPath, initializeLocalizationCli(cliSource));
+	for (const [file, text] of writes) {
+		const path = resolve(root, file);
+		mkdirSync(dirname(path), { recursive: true });
+		writeFileSync(path, text);
+	}
+	return { applied, skipped: reference.sites.length - applied, files };
+}
+
+if (import.meta.main) {
+	const usage =
+		"Usage: reapply-localization.ts create --source ROOT --base COMMIT --output FILE | apply --target ROOT --reference FILE";
+	const [command, ...args] = process.argv.slice(2);
+	const required =
+		command === "create" ? ["source", "base", "output"] : command === "apply" ? ["target", "reference"] : undefined;
+	if (!required) throw new Error(usage);
+	const { values } = parseArgs({
+		args,
+		options: Object.fromEntries(required.map(name => [name, { type: "string" as const }])),
+		strict: true,
+		allowPositionals: false,
+	});
+	if (required.some(name => typeof values[name] !== "string" || !values[name])) throw new Error(usage);
+	if (command === "create") {
+		const reference = createLocalizationReference(values.source as string, values.base as string);
+		const output = resolve(values.output as string);
+		mkdirSync(dirname(output), { recursive: true });
+		writeFileSync(output, `${JSON.stringify(reference)}\n`);
+		console.log(JSON.stringify(reference.stats));
+	} else {
+		console.log(
+			JSON.stringify(
+				applyLocalizationReference(
+					values.target as string,
+					JSON.parse(readFileSync(values.reference as string, "utf8")),
+				),
+			),
+		);
+	}
+}
