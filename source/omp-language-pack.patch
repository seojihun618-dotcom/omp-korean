index 0000000..a5bc157
--- /dev/null
+++ b/scripts/build-localized.ts
@@ -0,0 +1,79 @@
+#!/usr/bin/env bun
+import * as fs from "node:fs/promises";
+import { tmpdir } from "node:os";
+import * as path from "node:path";
+import { compileCodingAgent } from "../packages/coding-agent/scripts/compile-binary";
+
+const repoRoot = path.resolve(import.meta.dir, "..");
+if (
+	!(process.platform === "win32" && process.arch === "x64") &&
+	!(process.platform === "darwin" && (process.arch === "arm64" || process.arch === "x64"))
+) {
+	throw new Error("The localized executable builder supports Windows x64 and macOS arm64/x64 only");
+}
+const filename = process.platform === "win32" ? "omp-windows-x64.exe" : `omp-darwin-${process.arch}`;
+const outfile = path.join(repoRoot, "packages/coding-agent/binaries", filename);
+
+async function generate(args: string[]): Promise<void> {
+	await run([process.execPath, ...args]);
+}
+
+async function run(args: string[]): Promise<void> {
+	const child = Bun.spawn(args, {
+		cwd: repoRoot,
+		stdout: "inherit",
+		stderr: "inherit",
+		stdin: "ignore",
+	});
+	if ((await child.exited) !== 0) throw new Error(`Command failed: ${args.join(" ")}`);
+}
+
+await fs.mkdir(path.dirname(outfile), { recursive: true });
+// Bun 1.4.4 cannot copy a compiler runtime whose executablePath contains non-ASCII characters.
+const runtimeDirectory = await fs.mkdtemp(path.join(tmpdir(), "omp-compiler-"));
+const runtime = path.join(runtimeDirectory, process.platform === "win32" ? "bun.exe" : "bun");
+try {
+	await fs.copyFile(process.execPath, runtime);
+	if (process.platform !== "win32") await fs.chmod(runtime, 0o755);
+	await generate(["run", "gen:stats"]);
+	const collabManifest = await Bun.file(path.join(repoRoot, "packages/collab-web/package.json")).json();
+	const exportSource = await fs.readFile(
+		path.join(repoRoot, "packages/coding-agent/src/export/html/index.ts"),
+		"utf8",
+	);
+	if (exportSource.includes("localized-viewer.generated.txt"))
+		await generate(["--cwd=packages/collab-web", "run", "gen:export-viewer", "--embedded"]);
+	// Unmodified hosted exports must keep their upstream-published content hash.
+	else if (typeof collabManifest.scripts?.["gen:export-viewer"] !== "string")
+		await generate(["--cwd=packages/collab-web", "run", "gen:tool-views"]);
+	await compileCodingAgent({
+		repoRoot,
+		entrypoint: path.join(repoRoot, "packages/coding-agent/src/cli.ts"),
+		outfile,
+		native: { platform: process.platform, arch: process.arch },
+		// Use the bundled runtime without downloading a separate compiler target.
+		executablePath: runtime,
+		minifyIdentifiers: true,
+		skipBuiltinCodesign: process.platform === "darwin",
+	});
+	if (process.platform === "darwin") {
+		await fs.chmod(outfile, 0o755);
+		// Match upstream's local build signing so the embedded Bun runtime can use JIT.
+		await run([
+			"codesign",
+			"--force",
+			"--sign",
+			"-",
+			"--entitlements",
+			path.join(repoRoot, "scripts/macos-entitlements.plist"),
+			outfile,
+		]);
+	}
+} finally {
+	try {
+		await generate(["run", "gen:stats:reset"]);
+	} finally {
+		await fs.rm(runtimeDirectory, { recursive: true, force: true });
+	}
+}
+console.log(`Localized executable built: ${outfile}`);
