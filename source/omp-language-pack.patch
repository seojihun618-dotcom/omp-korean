+	const dispatcherSource = await fs.readFile(
+		kit
+			? path.join(kit, "scripts/localized-update.ts")
+			: path.join(previousRoot, "packages/coding-agent/src/cli/localized-update.ts"),
+		"utf8",
+	);
+	const project = new Project({ useInMemoryFileSystem: true });
+	const dispatcher = project.createSourceFile("localized-update.ts", dispatcherSource);
+	// Latest upstream's compiler does not know our build marker; retain fail-closed routing in the copied source.
+	dispatcher.getVariableDeclarationOrThrow("LOCALIZED_BUILD").setInitializer("true");
+	await fs.writeFile(dispatcherPath, dispatcher.getFullText());
+	const cliPath = path.join(cliDirectory, "update-cli.ts");
+	const source = project.createSourceFile("update-cli.ts", await fs.readFile(cliPath, "utf8"));
+	const handler = source.getFunctionOrThrow("runUpdateCommand");
+	const parameter = handler.getParameters()[0]?.getNameNode();
+	if (!parameter || parameter.getKind() !== SyntaxKind.Identifier || !handler.isAsync())
+		throw new Error("Latest update CLI has an unsupported command signature");
+	const managerDeclaration = handler
+		.getStatements()
+		.filter(Node.isVariableStatement)
+		.flatMap(statement => statement.getDeclarations())
+		.find(declaration =>
+			declaration
+				.getDescendantsOfKind(SyntaxKind.CallExpression)
+				.some(call => call.getExpression().getText() === "managedInstallName"),
+		);
+	if (!managerDeclaration || !Node.isIdentifier(managerDeclaration.getNameNode()))
+		throw new Error("Latest update CLI has no managed-install check");
+	const managerName = managerDeclaration.getName();
+	const managerGuard = handler
+		.getStatements()
+		.filter(Node.isIfStatement)
+		.find(statement => {
+			if (statement.getExpression().getText() !== managerName || statement.getElseStatement()) return false;
+			const body = statement.getThenStatement();
+			const last = Node.isBlock(body) ? body.getStatements().at(-1) : undefined;
+			return last !== undefined && Node.isReturnStatement(last) && !last.getExpression();
+		});
+	if (!managerGuard || managerGuard.getStart() < managerDeclaration.getStart())
+		throw new Error("Latest update CLI has an unsupported managed-install guard");
+	const versionImport = source
+		.getImportDeclarations()
+		.filter(declaration => declaration.getModuleSpecifierValue() === "@oh-my-pi/pi-utils")
+		.flatMap(declaration => declaration.getNamedImports())
+		.find(binding => binding.getName() === "VERSION");
+	const versionName =
+		versionImport?.getAliasNode()?.getText() ??
+		versionImport?.getName() ??
+		source.getVariableDeclaration("VERSION")?.getName();
+	if (!versionName) throw new Error("Latest update CLI has no installed version binding");
+	let localizedImport = source.getImportDeclaration("./localized-update");
+	let binding = localizedImport?.getNamedImports().find(specifier => specifier.getName() === "runLocalizedUpdate");
+	if (!binding) {
+		const identifiers = new Set(
+			source.getDescendantsOfKind(SyntaxKind.Identifier).map(identifier => identifier.getText()),
+		);
+		let alias = "runLocalizedUpdate";
+		while (identifiers.has(alias)) alias = `_${alias}`;
+		if (!localizedImport) localizedImport = source.addImportDeclaration({ moduleSpecifier: "./localized-update" });
+		binding = localizedImport.addNamedImport({
+			name: "runLocalizedUpdate",
+			...(alias !== "runLocalizedUpdate" ? { alias } : {}),
+		});
+	}
+	if (localizedImport?.isTypeOnly() || binding.isTypeOnly())
+		throw new Error("Latest update CLI has a type-only localized dispatcher import");
+	const dispatcherName = binding.getAliasNode()?.getText() ?? binding.getName();
+	const guard = `if (await ${dispatcherName}(${parameter.getText()}, ${versionName})) return;`;
+	const existingCalls = handler
+		.getDescendantsOfKind(SyntaxKind.CallExpression)
+		.filter(call => call.getExpression().getText() === dispatcherName);
+	if (existingCalls.length) {
+		const statement = existingCalls[0].getFirstAncestorByKind(SyntaxKind.IfStatement);
+		if (
+			existingCalls.length !== 1 ||
+			statement?.getParent() !== handler.getBody() ||
+			statement.getText().replace(/\s+/g, "") !== guard.replace(/\s+/g, "")
+		) {
+			throw new Error("Latest update CLI has an unsupported localized dispatcher placement");
+		}
+		statement.remove();
+	}
+	handler.insertStatements(handler.getStatements().indexOf(managerGuard) + 1, guard);
+	const entryPath = path.join(candidate, "packages/coding-agent/src/cli.ts");
+	const entry = initializeLocalizationCli(await fs.readFile(entryPath, "utf8"));
+	await fs.writeFile(cliPath, source.getFullText());
+	await fs.writeFile(entryPath, entry);
+}
+
+export async function updateLocalized(args: string[]): Promise<void> {
+	const options = parseOptions(args);
+	const metadataPath =
+		options.metadataPath ?? path.join(path.dirname(options.executablePath!), "omp-portable-update.json");
+	const originalMetadata = options.metadataPath ? await fs.readFile(metadataPath, "utf8") : undefined;
+	const metadata: LocalizedInstall = originalMetadata
+		? parseMetadata(JSON.parse(originalMetadata))
+		: {
+				schemaVersion: 1,
+				repoRoot: options.kit!,
+				bunPath: process.execPath,
+				executablePath: options.executablePath!,
+				localeDir: path.join(path.dirname(options.executablePath!), "locales"),
+				version: options.installedVersion!,
+			};
+	if (options.kit) metadata.bunPath = process.execPath;
+	if (path.resolve(path.dirname(metadataPath)) !== path.resolve(path.dirname(metadata.executablePath))) {
+		throw new Error("Metadata must be beside the installed executable");
+	}
+	const version = options.version ?? (await latestLocalizedVersion());
+	console.log(`Localized installed version: ${metadata.version}; upstream stable: ${version}`);
+	if (options.check) return;
+	if (compareStableVersions(version, metadata.version) < 0)
+		throw new Error("Refusing to downgrade the Korean installation");
+	if (!options.force && compareStableVersions(version, metadata.version) === 0) {
+		console.log("Localized installation is already up to date. Use --force to rebuild.");
+		return;
+	}
+	if (process.platform !== "win32" || process.arch !== "x64") {
+		throw new Error("This localized source installer currently supports Windows x64 only");
+	}
+	const lockPath = `${metadataPath}.update-lock`;
+	const lock = await fs.open(lockPath, "wx");
+	try {
+		await lock.writeFile(String(process.pid));
+		const root = path.join(path.dirname(metadataPath), "updates");
+		await fs.mkdir(root, { recursive: true });
+		const transaction = await fs.mkdtemp(path.join(root, `${version}-`));
+		const candidate = path.join(transaction, "source");
+		console.log(`Preparing isolated source candidate: ${candidate}`);
+		const referencePath = options.kit
+			? path.join(options.kit, "reference.json")
+			: path.join(metadata.repoRoot, "localization-reference.json");
+		const reference: LocalizationReference = (await Bun.file(referencePath).exists())
+			? JSON.parse(await fs.readFile(referencePath, "utf8"))
+			: metadata.upstreamBase
+				? createLocalizationReference(metadata.repoRoot, metadata.upstreamBase)
+				: (() => {
+						throw new Error("Missing translation reference; keeping the Korean installation");
+					})();
+		const archive = options.offline
+			? new Uint8Array(
+					await fs.readFile(
+						options.sourceArchive ?? path.join(metadata.repoRoot, "archives", `v${version}.tar.gz`),
+					),
+				)
+			: await fetchBytes(`https://codeload.github.com/can1357/oh-my-pi/tar.gz/refs/tags/v${version}`, 15 * 60_000);
+		await exportSourceArchive(archive, candidate);
+		const result = applyLocalizationReference(candidate, reference);
+		console.log(`Reapplied ${result.applied} known translations; ${result.skipped} changed strings left in English.`);
+		await fs.writeFile(path.join(candidate, "localization-reference.json"), `${JSON.stringify(reference)}\n`);
+		await configureRepeatedUpdates(candidate, options.kit, metadata.repoRoot);
+		const manifest = (await Bun.file(path.join(candidate, "packages/coding-agent/package.json")).json()) as {
+			version: string;
+		};
+		if (manifest.version !== version) throw new Error("Candidate package version does not match upstream release");
+		// Candidate sources and the original reference remain usable without a Git checkout.
+		const env = {
+			...process.env,
+			PATH: `${path.dirname(metadata.bunPath)}${path.delimiter}${process.env.PATH ?? ""}`,
+		};
+		await command(
+			[
+				metadata.bunPath,
+				"install",
+				"--frozen-lockfile",
+				"--ignore-scripts",
+				...(options.offline ? ["--offline"] : []),
+			],
+			candidate,
+			env,
+		);
+		await installNative(candidate, metadata, options.offline);
+		await command([metadata.bunPath, "scripts/build-localized.ts"], candidate, env);
+		const binary = path.join(candidate, "packages/coding-agent/binaries/omp-windows-x64.exe");
+		await verifyBinary(binary, version, metadata, transaction);
+		const suffix = randomUUID();
+		const staged = `${metadata.executablePath}.${suffix}.new`;
+		const backup = `${metadata.executablePath}.${suffix}.bak`;
+		const stagedMetadata = `${metadataPath}.${suffix}.new`;
+		const { upstreamBase: _legacyBase, ...current } = metadata;
+		const next = { ...current, repoRoot: candidate, version };
+		await fs.copyFile(binary, staged);
+		await fs.writeFile(stagedMetadata, `${JSON.stringify(next, null, 2)}\n`);
+		if (originalMetadata) await fs.writeFile(path.join(transaction, "previous-omp-localized.json"), originalMetadata);
+		await replaceLocalizedExecutable({
+			executablePath: metadata.executablePath,
+			stagedPath: staged,
+			backupPath: backup,
+			metadataPath,
+			stagedMetadataPath: stagedMetadata,
+			verifyInstalled: () => verifyBinary(metadata.executablePath, version, metadata, transaction),
+		});
+		console.log(
+			`Localized update installed: ${version}\nPrevious executable: ${backup}\nPrevious sources preserved: ${metadata.repoRoot}\nActive sources: ${candidate}`,
+		);
+	} finally {
+		await lock.close();
+		await fs.unlink(lockPath);
+	}
+}
+
+if (import.meta.main) {
+	try {
+		await updateLocalized(process.argv.slice(2));
+	} catch (error) {
+		console.error(
+			`Localized update failed: ${error instanceof Error ? error.message : String(error)}. The Korean installation was retained; no official English version was installed.`,
+		);
+		process.exitCode = 1;
+	}
+}
