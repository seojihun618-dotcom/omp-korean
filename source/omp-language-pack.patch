+			}) ?? [];
+		if (values.length) templates++;
+		const value =
+			comparison && file.endsWith("/session-info-overlay.ts")
+				? JSON.stringify(en[key])
+				: `${helper}(${[JSON.stringify(key), ...values].join(", ")})`;
