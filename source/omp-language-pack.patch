@@ -0,0 +1,35 @@
+import { expect, test } from "bun:test";
+import * as fs from "node:fs/promises";
+import { isolateDaemonForSmokeTest } from "../../src/daemon/client";
+import { DAEMON_DIR_ENV } from "../../src/daemon/protocol";
+
+test.skipIf(process.platform !== "win32")("smoke cleanup waits for Windows directory handles to close", async () => {
+	const previous = process.env[DAEMON_DIR_ENV];
+	const cleanup = await isolateDaemonForSmokeTest();
+	const root = process.env[DAEMON_DIR_ENV];
+	if (!root) throw new Error("Smoke isolation did not select a private directory");
+	const child = Bun.spawn([process.execPath, "-e", 'console.log("ready"); await Bun.stdin.text();'], {
+		cwd: root,
+		stdin: "pipe",
+		stdout: "pipe",
+		stderr: "pipe",
+	});
+	let release: NodeJS.Timeout | undefined;
+	try {
+		const reader = child.stdout.getReader();
+		const ready = await reader.read();
+		expect(new TextDecoder().decode(ready.value)).toContain("ready");
+		reader.releaseLock();
+		release = setTimeout(() => child.stdin.end(), 150);
+		// Windows holds the child's native cwd handle; fake timers cannot release that OS resource.
+		await cleanup();
+		expect(process.env[DAEMON_DIR_ENV]).toBe(previous);
+		expect(await fs.stat(root).then(() => true, () => false)).toBe(false);
+	} finally {
+		clearTimeout(release);
+		child.stdin.end();
+		child.kill();
+		await child.exited;
+		await fs.rm(root, { recursive: true, force: true, maxRetries: 10, retryDelay: 100 });
+	}
+}, 15_000);
