+					"-c",
+					"core.autocrlf=false",
+					"-c",
+					"user.name=Reference Test",
+					"-c",
+					"user.email=reference@example.invalid",
+					...args,
+				],
+				{ cwd: old, encoding: "utf8" },
+			);
