+
+function execute(
+	source: string,
+	messages: Record<string, string>,
+): { exports: Record<string, (...args: unknown[]) => unknown>; events: string[] } {
+	const events: string[] = [];
+	const withoutImports = source.replace(
+		/^import \{ t as (\w+) \} from "@oh-my-pi\/pi-utils\/i18n(?:-browser)?";\r?\n/gm,
+		(_line, name: string) => `const ${name} = translate;\n`,
+	);
+	const compiled = ts.transpileModule(withoutImports, {
+		compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022 },
+	}).outputText;
+	const module = { exports: {} };
+	const translate = (key: string, ...values: string[]) =>
+		(messages[key] ?? key.split("\u0004", 1)[0]).replace(
+			/\{(\d+)\}/g,
+			(_match, index: string) => values[Number(index)],
+		);
+	new Function("exports", "module", "translate", "events", compiled)(module.exports, module, translate, events);
+	return { exports: module.exports, events };
+}
