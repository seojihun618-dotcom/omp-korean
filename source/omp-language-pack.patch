+				const first = node.arguments[0];
+				const argument =
+					method === "bold"
+						? first
+						: method === "fg" && first && ts.isStringLiteral(first) && first.text === "dim"
+							? node.arguments[1]
+							: undefined;
+				if (
+					argument &&
+					ts.isCallExpression(argument) &&
+					argument.arguments.length === 1 &&
+					ts.isIdentifier(argument.expression) &&
+					argument.expression.text === helper &&
+					ts.isStringLiteral(argument.arguments[0])
+				) {
+					const english = argument.arguments[0].text.split("\u0004", 1)[0];
+					if (method === "bold" || english.endsWith(":"))
+						labels.push({
+							start: argument.getStart(generated),
+							end: argument.end,
+							value: JSON.stringify(english),
+						});
+				}
+			}
+			ts.forEachChild(node, child => restoreLabels(child, report));
+		}
+		restoreLabels(generated);
+		for (const label of labels.sort((left, right) => right.start - left.start))
+			output = output.slice(0, label.start) + label.value + output.slice(label.end);
+	}
+	changes.push({ file, source: output, count });
+}
+const report = {
+	files: changes.length,
+	aligned,
+	templates,
+	aliases,
+	entries: Object.keys(ko).length,
+	issues,
+	skipped,
+	comparisons,
+	appended,
+	contexts,
+};
+if (reportPath) writeFileSync(resolve(root, reportPath), `${JSON.stringify(report, null, 2)}\n`);
+console.log(
+	JSON.stringify(
+		reportPath
+			? {
+					files: report.files,
+					aligned,
+					templates,
+					aliases,
+					entries: report.entries,
+					issues: issues.length,
+					skipped: skipped.length,
+					comparisons: comparisons.length,
+					appended: appended.length,
+					contexts: contexts.length,
+					reportPath,
+				}
+			: report,
+		null,
+		2,
+	),
+);
+if (apply) {
+	if (issues.length) throw new Error(`Resolve ${issues.length} extraction ambiguities before applying`);
+	for (const change of changes) writeFileSync(resolve(root, change.file), change.source);
+	mkdirSync(dirname(enPath), { recursive: true });
+	writeFileSync(
+		enPath,
+		`${JSON.stringify(Object.fromEntries(Object.entries(en).sort(([a], [b]) => a.localeCompare(b))), null, "\t")}\n`,
+	);
+	writeFileSync(
+		koPath,
+		`${JSON.stringify(Object.fromEntries(Object.entries(ko).sort(([a], [b]) => a.localeCompare(b))), null, "\t")}\n`,
+	);
+}
diff --git a/scripts/install-localized.ts b/scripts/install-localized.ts
new file mode 100644
index 0000000..fe18853
--- /dev/null
+++ b/scripts/install-localized.ts
@@ -0,0 +1,121 @@
+#!/usr/bin/env bun
+import * as fs from "node:fs/promises";
+import * as path from "node:path";
+import { randomUUID } from "node:crypto";
+import { parseMetadata, type LocalizedInstall } from "./update-localized";
+
+const repoRoot = path.resolve(import.meta.dir, "..");
+
+async function run(args: string[], capture = false, env: NodeJS.ProcessEnv = process.env): Promise<string> {
+	const child = Bun.spawn(args, {
+		cwd: repoRoot,
+		env,
+		stdin: "ignore",
+		stdout: capture ? "pipe" : "inherit",
+		stderr: "inherit",
+	});
+	const output = capture ? new Response(child.stdout as ReadableStream).text() : Promise.resolve("");
+	const [code, text] = await Promise.all([child.exited, output]);
+	if (code !== 0) throw new Error(`Command failed (${code}): ${args.join(" ")}`);
+	return text;
+}
+
+async function main(): Promise<void> {
+	if (process.platform !== "win32" || process.arch !== "x64") {
+		throw new Error("This isolated installer currently supports Windows x64.");
+	}
+	let directory = path.join(
+		process.env.LOCALAPPDATA ?? path.join(process.env.USERPROFILE ?? "", "AppData", "Local"),
+		"omp-korean",
+	);
+	let changePath = true;
+	for (let index = 2; index < process.argv.length; index++) {
+		if (process.argv[index] === "--directory") {
+			const value = process.argv[++index];
+			if (!value || !path.isAbsolute(value)) throw new Error("--directory requires an absolute directory");
+			directory = value;
+		} else if (process.argv[index] === "--no-path") changePath = false;
+		else throw new Error(`Unknown installer option: ${process.argv[index]}`);
+	}
+	const official = path.join(process.env.LOCALAPPDATA ?? "", "omp");
+	if (path.resolve(directory).toLowerCase() === path.resolve(official).toLowerCase()) {
+		throw new Error("Choose a separate installation directory, not the official omp directory.");
+	}
+	const manifest = (await Bun.file(path.join(repoRoot, "packages/coding-agent/package.json")).json()) as {
+		version: string;
+	};
+	const upstreamBase = (await run(["git", "rev-parse", "HEAD"], true)).trim();
+	await run([process.execPath, path.join(repoRoot, "scripts/build-localized.ts")]);
+	const binary = path.join(repoRoot, "packages/coding-agent/binaries/omp-windows-x64.exe");
+	const version = (await run([binary, "--version"], true)).trim();
+	if (version !== `omp/${manifest.version}`) throw new Error(`Unexpected built version: ${version}`);
+	await run([binary, "--smoke-test"]);
+	await fs.mkdir(directory, { recursive: true });
+	const localeDir = path.join(directory, "locales");
+	await fs.mkdir(localeDir, { recursive: true });
+	for (const language of ["en", "ko"]) {
+		// Language packs belong to the user after installation; never overwrite edits.
+		try {
+			await fs.copyFile(
+				path.join(repoRoot, "packages/utils/src/locales", `${language}.json`),
+				path.join(localeDir, `${language}.json`),
+				fs.constants.COPYFILE_EXCL,
+			);
+		} catch (error) {
+			if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw error;
+		}
+	}
+	const executablePath = path.join(directory, "omp.exe");
+	const metadataPath = path.join(directory, "omp-localized.json");
+	const metadata: LocalizedInstall = parseMetadata({
+		schemaVersion: 1,
+		repoRoot,
+		bunPath: process.execPath,
+		executablePath,
+		localeDir,
+		upstreamBase,
+		version: manifest.version,
+	});
+	const id = randomUUID();
+	const pending = path.join(directory, `omp.${id}.pending.exe`);
+	const backup = path.join(directory, `omp.${id}.previous.exe`);
+	await fs.copyFile(binary, pending, fs.constants.COPYFILE_EXCL);
+	const installedHelp = await run([pending, "--help"], true, {
+		...process.env,
+		OMP_LANG: "ko",
+		OMP_LOCALE_DIR: localeDir,
+	});
+	if (!installedHelp.includes("--model")) throw new Error("Installed language pack did not produce usable help");
+	let backedUp = false;
+	let promoted = false;
+	try {
+		try {
+			await fs.rename(executablePath, backup);
+			backedUp = true;
+		} catch (error) {
+			if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+		}
+		await fs.rename(pending, executablePath);
+		promoted = true;
+		const temporaryMetadata = `${metadataPath}.${id}.tmp`;
+		await Bun.write(temporaryMetadata, `${JSON.stringify(metadata, null, 2)}\n`);
+		await fs.rename(temporaryMetadata, metadataPath);
+	} catch (error) {
+		if (promoted) await fs.rm(executablePath, { force: true });
+		if (backedUp) await fs.rename(backup, executablePath);
+		throw error;
+	}
+	if (changePath) {
+		const script =
+			'$dir=$env:OMP_LOCALIZED_INSTALL_DIR; $old=[Environment]::GetEnvironmentVariable("Path","User"); $parts=@($old -split ";" | Where-Object { $_ -and $_.TrimEnd("\\") -ine $dir.TrimEnd("\\") }); [Environment]::SetEnvironmentVariable("Path", (@($dir)+$parts -join ";"), "User")';
+		await run(["powershell.exe", "-NoProfile", "-NonInteractive", "-Command", script], false, {
+			...process.env,
+			OMP_LOCALIZED_INSTALL_DIR: directory,
+		});
+	}
+	console.log(`Installed language-pack omp ${manifest.version}: ${executablePath}`);
+	console.log(`Editable language pack: ${path.join(localeDir, "ko.json")}`);
+	console.log(changePath ? "Restart your terminal to use the isolated omp from PATH." : "PATH unchanged.");
+}
+
+if (import.meta.main) await main();
