+): void {
+	const directory = mkdtempSync(resolve(tmpdir(), "omp-reapply-"));
+	const root = resolve(directory, "latest");
+	const old = resolve(directory, "old");
+	function put(where: string, name: string, text: string): void {
+		mkdirSync(dirname(resolve(where, name)), { recursive: true });
+		writeFileSync(resolve(where, name), text);
+	}
