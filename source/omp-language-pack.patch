+	for (const { relative, file } of members) {
+		const target = path.join(candidate, relative);
+		await fs.mkdir(path.dirname(target), { recursive: true });
+		await Bun.write(target, file);
+	}
+}
+
+export async function configureRepeatedUpdates(
+	candidate: string,
+	kit: string | undefined,
+	previousRoot: string,
+): Promise<void> {
+	const scripts = path.join(candidate, "scripts");
+	await fs.mkdir(scripts, { recursive: true });
+	for (const name of ["build-localized.ts", "update-localized.ts", "reapply-localization.ts"]) {
+		await fs.copyFile(path.join(kit ?? previousRoot, "scripts", name), path.join(scripts, name));
+	}
+	const bundledUpdater = path.join(kit ?? path.join(previousRoot, "scripts"), "update-localized.js");
+	if (await Bun.file(bundledUpdater).exists())
+		await fs.copyFile(bundledUpdater, path.join(scripts, "update-localized.js"));
+	const cliDirectory = path.join(candidate, "packages/coding-agent/src/cli");
+	const dispatcherPath = path.join(cliDirectory, "localized-update.ts");
+	const dispatcherSource = await fs.readFile(
+		kit
+			? path.join(kit, "scripts/localized-update.ts")
+			: path.join(previousRoot, "packages/coding-agent/src/cli/localized-update.ts"),
+		"utf8",
+	);
+	const project = new Project({ useInMemoryFileSystem: true });
+	const dispatcher = project.createSourceFile("localized-update.ts", dispatcherSource);
+	// Latest upstream's compiler does not know our build marker; retain fail-closed routing in the copied source.
+	dispatcher.getVariableDeclarationOrThrow("LOCALIZED_BUILD").setInitializer("true");
+	await fs.writeFile(dispatcherPath, dispatcher.getFullText());
+	const cliPath = path.join(cliDirectory, "update-cli.ts");
+	const source = project.createSourceFile("update-cli.ts", await fs.readFile(cliPath, "utf8"));
+	const handler = source.getFunctionOrThrow("runUpdateCommand");
+	const parameter = handler.getParameters()[0]?.getNameNode();
+	if (!parameter || parameter.getKind() !== SyntaxKind.Identifier || !handler.isAsync())
+		throw new Error("Latest update CLI has an unsupported command signature");
+	const managerDeclaration = handler
+		.getStatements()
+		.filter(Node.isVariableStatement)
+		.flatMap(statement => statement.getDeclarations())
+		.find(declaration =>
+			declaration
+				.getDescendantsOfKind(SyntaxKind.CallExpression)
+				.some(call => call.getExpression().getText() === "managedInstallName"),
+		);
+	if (!managerDeclaration || !Node.isIdentifier(managerDeclaration.getNameNode()))
+		throw new Error("Latest update CLI has no managed-install check");
+	const managerName = managerDeclaration.getName();
+	const managerGuard = handler
+		.getStatements()
+		.filter(Node.isIfStatement)
+		.find(statement => {
+			if (statement.getExpression().getText() !== managerName || statement.getElseStatement()) return false;
+			const body = statement.getThenStatement();
+			const last = Node.isBlock(body) ? body.getStatements().at(-1) : undefined;
+			return last !== undefined && Node.isReturnStatement(last);
+		});
+	if (!managerGuard || managerGuard.getStart() < managerDeclaration.getStart())
+		throw new Error("Latest update CLI has an unsupported managed-install guard");
+	const versionImport = source
+		.getImportDeclarations()
+		.filter(declaration => declaration.getModuleSpecifierValue() === "@oh-my-pi/pi-utils")
+		.flatMap(declaration => declaration.getNamedImports())
+		.find(binding => binding.getName() === "VERSION");
+	const versionName =
+		versionImport?.getAliasNode()?.getText() ??
+		versionImport?.getName() ??
+		source.getVariableDeclaration("VERSION")?.getName();
+	if (!versionName) throw new Error("Latest update CLI has no installed version binding");
+	let localizedImport = source.getImportDeclaration("./localized-update");
+	let binding = localizedImport?.getNamedImports().find(specifier => specifier.getName() === "runLocalizedUpdate");
+	if (!binding) {
+		const identifiers = new Set(
+			source.getDescendantsOfKind(SyntaxKind.Identifier).map(identifier => identifier.getText()),
+		);
+		let alias = "runLocalizedUpdate";
+		while (identifiers.has(alias)) alias = `_${alias}`;
+		if (!localizedImport) localizedImport = source.addImportDeclaration({ moduleSpecifier: "./localized-update" });
+		binding = localizedImport.addNamedImport({
+			name: "runLocalizedUpdate",
+			...(alias !== "runLocalizedUpdate" ? { alias } : {}),
+		});
+	}
+	if (localizedImport?.isTypeOnly() || binding.isTypeOnly())
+		throw new Error("Latest update CLI has a type-only localized dispatcher import");
+	const dispatcherName = binding.getAliasNode()?.getText() ?? binding.getName();
+	const channelDeclaration = handler
+		.getStatements()
+		.filter(Node.isVariableStatement)
+		.flatMap(statement => statement.getDeclarations())
+		.find(declaration => declaration.getName() === "channel");
+	const requestDeclaration = handler
+		.getStatements()
+		.filter(Node.isVariableStatement)
+		.flatMap(statement => statement.getDeclarations())
+		.find(declaration => {
+			const value = declaration.getInitializerIfKind(SyntaxKind.ObjectLiteralExpression);
+			return (
+				declaration.getName() === "request" &&
+				value?.getProperty("force") &&
+				value.getProperty("check") &&
+				value.getProperty("channel") &&
+				value.getProperty("onProgress")
+			);
+		});
+	const localizedOptions =
+		requestDeclaration?.getName() ??
+		(channelDeclaration ? `{ ...${parameter.getText()}, channel }` : parameter.getText());
+	const persistChannel = source.getFunction("persistChannel");
+	const persistRequested = requestDeclaration
+		?.getInitializerIfKind(SyntaxKind.ObjectLiteralExpression)
+		?.getProperty("persistChannel")
+		? `${requestDeclaration.getName()}.persistChannel`
+		: `${parameter.getText()}.channel !== undefined`;
+	const persistedChannel = requestDeclaration
+		? `${requestDeclaration.getName()}.channel`
+		: (channelDeclaration?.getName() ?? `${parameter.getText()}.channel`);
+	const outcomeGuard = (name: string): string =>
+		persistChannel
+			? `if (${name}) {\n` +
+				`if (${name}.kind === "installed" && ${persistRequested}) persistChannel(${persistedChannel});\n` +
+				`return ${name};\n}`
+			: `if (${name}) return ${name};`;
+	const existingCalls = handler
+		.getDescendantsOfKind(SyntaxKind.CallExpression)
+		.filter(call => call.getExpression().getText() === dispatcherName);
+	if (existingCalls.length > 1) throw new Error("Latest update CLI has an unsupported localized dispatcher placement");
+	let currentDispatch:
+		| { declaration: VariableStatement; guard: IfStatement; arguments: string; name: string }
+		| undefined;
+	if (existingCalls.length === 1) {
+		const call = existingCalls[0];
+		const args = call
+			.getArguments()
+			.map(argument => argument.getText().replace(/\s+/g, ""))
+			.join(",");
+		if (
+			args !== `${parameter.getText()},${versionName}` &&
+			args !== `${localizedOptions.replace(/\s+/g, "")},${versionName}`
+		) {
+			throw new Error("Latest update CLI has unsupported localized dispatcher arguments");
+		}
+		const declaration = call.getFirstAncestorByKind(SyntaxKind.VariableStatement);
+		if (declaration) {
+			const variable = declaration.getDeclarations();
+			const name = variable.length === 1 ? variable[0].getName() : undefined;
+			const guard = declaration.getNextSiblingIfKind(SyntaxKind.IfStatement);
+			if (
+				!guard ||
+				!name ||
+				(guard.getText().replace(/\s+/g, "") !== `if(${name})return${name};` &&
+					guard.getText().replace(/\s+/g, "") !== outcomeGuard(name).replace(/\s+/g, "")) ||
+				variable[0].getInitializer()?.getText() !== `await ${call.getText()}`
+			) {
+				throw new Error("Latest update CLI has an unsupported localized dispatcher placement");
+			}
+			currentDispatch = { declaration, guard, arguments: args, name };
+		} else {
+			const guard = call.getFirstAncestorByKind(SyntaxKind.IfStatement);
+			if (
+				guard?.getParent() !== handler.getBody() ||
+				guard.getText().replace(/\s+/g, "") !==
+					`if(await${dispatcherName}(${parameter.getText()},${versionName}))return;`
+			) {
+				throw new Error("Latest update CLI has an unsupported localized dispatcher placement");
+			}
+			guard.remove();
+		}
+	}
+	const identifiers = new Set(
+		source.getDescendantsOfKind(SyntaxKind.Identifier).map(identifier => identifier.getText()),
+	);
+	let outcomeName = "localized";
+	while (identifiers.has(outcomeName)) outcomeName = `_${outcomeName}`;
+	const dispatch =
+		`const ${outcomeName} = await ${dispatcherName}(${localizedOptions}, ${versionName});\n` +
+		outcomeGuard(outcomeName);
+	const lockDeclaration = handler
+		.getStatements()
+		.filter(Node.isVariableStatement)
+		.flatMap(statement => statement.getDeclarations())
+		.find(declaration =>
+			declaration
+				.getDescendantsOfKind(SyntaxKind.CallExpression)
+				.some(call => call.getExpression().getText() === "acquireInstallLock"),
+		);
+	const installTry = lockDeclaration
+		? handler
+				.getStatements()
+				.filter(Node.isTryStatement)
+				.find(
+					statement =>
+						statement.getStart() > lockDeclaration.getStart() &&
+						statement
+							.getFinallyBlock()
+							?.getDescendantsOfKind(SyntaxKind.CallExpression)
+							.some(
+								call =>
+									call.getExpression().getText().replace("?.", ".") === `${lockDeclaration.getName()}.release`,
+							),
+				)
+		: undefined;
+	if (lockDeclaration && !installTry) throw new Error("Latest update CLI has an unsupported install-lock guard");
+	const target = installTry?.getTryBlock() ?? handler.getBodyOrThrow();
+	const retainDispatch =
+		currentDispatch?.declaration.getParent() === target &&
+		currentDispatch.arguments === `${localizedOptions.replace(/\s+/g, "")},${versionName}` &&
+		currentDispatch.declaration.getStart() > managerGuard.getEnd() &&
+		currentDispatch.guard.getText().replace(/\s+/g, "") === outcomeGuard(currentDispatch.name).replace(/\s+/g, "");
+	if (!retainDispatch) {
+		currentDispatch?.guard.remove();
+		currentDispatch?.declaration.remove();
+		if (installTry) installTry.getTryBlock().insertStatements(0, dispatch);
+		else {
+			const channelStatement = channelDeclaration?.getFirstAncestorByKind(SyntaxKind.VariableStatement);
+			const anchor =
+				channelStatement && channelStatement.getStart() > managerGuard.getStart() ? channelStatement : managerGuard;
+			handler.insertStatements(handler.getStatementsWithComments().indexOf(anchor) + 1, dispatch);
+		}
+	}
+	const entryPath = path.join(candidate, "packages/coding-agent/src/cli.ts");
+	const entry = initializeLocalizationCli(await fs.readFile(entryPath, "utf8"));
+	await fs.writeFile(cliPath, source.getFullText());
+	await fs.writeFile(entryPath, entry);
+}
+
+export async function acquireLocalizedUpdateLock(metadataPath: string): Promise<{ release(): Promise<void> }> {
+	const lockPath = `${metadataPath}.update-lock`;
+	const preparedPath = `${lockPath}.${randomUUID()}.new`;
+	// Keep this DB: unlinking it lets peers lock different files. Bun supplies SQLite without a kit addon.
+	const database = new Database(`${lockPath}.sqlite`);
+	let owned = false;
+	const release = async (): Promise<void> => {
+		try {
+			if (owned) {
+				await fs.unlink(lockPath);
+				owned = false;
+			}
+		} finally {
+			try {
+				await fs.rm(preparedPath, { force: true });
+			} finally {
+				database.close();
+			}
+		}
+	};
+	try {
+		database.exec("PRAGMA busy_timeout = 0; BEGIN EXCLUSIVE;");
+		let previous: string | undefined;
+		try {
+			previous = await fs.readFile(lockPath, "utf8");
+		} catch (error) {
+			if (!isEnoent(error)) throw error;
+		}
+		if (previous !== undefined) {
+			const text = previous.trim();
+			const pid = /^\d+$/.test(text) ? Number(text) : NaN;
+			if (!Number.isSafeInteger(pid) || pid <= 0 || isPidAlive(pid)) {
+				throw new Error(`Localized update already running or lock owner is unknown: ${lockPath}`);
+			}
+			await fs.unlink(lockPath);
+		}
+		// Publish the PID atomically; a killed writer must not leave an empty owner file.
+		await fs.writeFile(preparedPath, String(process.pid), { flag: "wx" });
+		await fs.link(preparedPath, lockPath);
+		owned = true;
+		await fs.unlink(preparedPath);
+		return { release };
+	} catch (error) {
+		await release();
+		if (isFsError(error) && (error.code.startsWith("SQLITE_BUSY") || error.code === "EEXIST")) {
+			throw new Error(`Localized update already running: ${lockPath}`, { cause: error });
+		}
+		throw error;
+	}
+}
+
+export async function updateLocalized(args: string[]): Promise<void> {
+	const options = parseOptions(args);
+	const metadataPath =
+		options.metadataPath ?? path.join(path.dirname(options.executablePath!), "omp-portable-update.json");
+	const originalMetadata = options.metadataPath ? await fs.readFile(metadataPath, "utf8") : undefined;
+	const metadata: LocalizedInstall = originalMetadata
+		? parseMetadata(JSON.parse(originalMetadata))
+		: {
+				schemaVersion: 1,
+				repoRoot: options.kit!,
+				bunPath: process.execPath,
+				executablePath: options.executablePath!,
+				localeDir: path.join(path.dirname(options.executablePath!), "locales"),
+				version: options.installedVersion!,
+			};
+	if (options.kit) metadata.bunPath = process.execPath;
+	if (path.resolve(path.dirname(metadataPath)) !== path.resolve(path.dirname(metadata.executablePath))) {
+		throw new Error("Metadata must be beside the installed executable");
+	}
+	const version = options.version ?? (await latestLocalizedVersion());
+	console.log(__ompTranslate("Localized installed version: {0}; upstream stable: {1}", metadata.version, version));
+	if (options.check) return;
+	if (compareStableVersions(version, metadata.version) < 0)
+		throw new Error("Refusing to downgrade the Korean installation");
+	if (!options.force && compareStableVersions(version, metadata.version) === 0) {
+		console.log(__ompTranslate("Localized installation is already up to date. Use --force to rebuild."));
+		return;
+	}
+	if (
+		!(process.platform === "win32" && process.arch === "x64") &&
+		!(process.platform === "darwin" && (process.arch === "arm64" || process.arch === "x64"))
+	) {
+		throw new Error("Localized source updates support Windows x64 and macOS arm64/x64 only");
+	}
+	const lock = await acquireLocalizedUpdateLock(metadataPath);
+	try {
+		const root = path.join(path.dirname(metadataPath), "updates");
+		await fs.mkdir(root, { recursive: true });
+		const transaction = await fs.mkdtemp(path.join(root, `${version}-`));
+		const candidate = path.join(transaction, "source");
+		console.log(__ompTranslate("Preparing isolated source candidate: {0}", candidate));
+		const referencePath = options.kit
+			? path.join(options.kit, "reference.json")
+			: path.join(metadata.repoRoot, "localization-reference.json");
+		const reference: LocalizationReference = (await Bun.file(referencePath).exists())
+			? JSON.parse(await fs.readFile(referencePath, "utf8"))
+			: metadata.upstreamBase
+				? createLocalizationReference(metadata.repoRoot, metadata.upstreamBase)
+				: (() => {
+						throw new Error("Missing translation reference; keeping the Korean installation");
+					})();
+		const archive = options.offline
+			? new Uint8Array(
+					await fs.readFile(
+						options.sourceArchive ?? path.join(metadata.repoRoot, "archives", `v${version}.tar.gz`),
+					),
+				)
+			: await fetchBytes(`https://codeload.github.com/can1357/oh-my-pi/tar.gz/refs/tags/v${version}`, 15 * 60_000);
+		await exportSourceArchive(archive, candidate);
+		const result = applyLocalizationReference(candidate, reference);
+		console.log(
+			__ompTranslate(
+				"Reapplied {0} known translations; {1} changed strings left in English.",
+				`${result.applied}`,
+				`${result.skipped}`,
+			),
+		);
+		await fs.writeFile(path.join(candidate, "localization-reference.json"), `${JSON.stringify(reference)}\n`);
+		await configureRepeatedUpdates(candidate, options.kit, metadata.repoRoot);
+		const manifest = (await Bun.file(path.join(candidate, "packages/coding-agent/package.json")).json()) as {
+			version: string;
+		};
+		if (manifest.version !== version) throw new Error("Candidate package version does not match upstream release");
+		// Candidate sources and the original reference remain usable without a Git checkout.
+		const env = {
+			...process.env,
+			PATH: `${path.dirname(metadata.bunPath)}${path.delimiter}${process.env.PATH ?? ""}`,
+		};
+		await command(
+			[
+				metadata.bunPath,
+				"install",
+				"--frozen-lockfile",
+				"--ignore-scripts",
+				...(options.offline ? ["--offline"] : []),
+			],
+			candidate,
+			env,
+		);
+		await installNative(candidate, metadata, options.offline);
+		await command([metadata.bunPath, "scripts/build-localized.ts"], candidate, env);
+		const filename = process.platform === "win32" ? "omp-windows-x64.exe" : `omp-darwin-${process.arch}`;
+		const binary = path.join(candidate, "packages/coding-agent/binaries", filename);
+		if (process.platform !== "win32") await fs.chmod(binary, 0o755);
+		await verifyBinary(binary, version, metadata, transaction);
+		const suffix = randomUUID();
+		const staged = `${metadata.executablePath}.${suffix}.new`;
+		const backup = `${metadata.executablePath}.${suffix}.bak`;
+		const stagedMetadata = `${metadataPath}.${suffix}.new`;
+		const { upstreamBase: _legacyBase, ...current } = metadata;
+		const next = { ...current, repoRoot: candidate, version };
+		await fs.copyFile(binary, staged);
+		if (process.platform !== "win32") await fs.chmod(staged, 0o755);
+		await fs.writeFile(stagedMetadata, `${JSON.stringify(next, null, 2)}\n`);
+		if (originalMetadata) await fs.writeFile(path.join(transaction, "previous-omp-localized.json"), originalMetadata);
+		await replaceLocalizedExecutable({
+			executablePath: metadata.executablePath,
+			stagedPath: staged,
+			backupPath: backup,
+			metadataPath,
+			stagedMetadataPath: stagedMetadata,
+			verifyInstalled: () => verifyBinary(metadata.executablePath, version, metadata, transaction),
+		});
+		console.log(
+			__ompTranslate(
+				"Localized update installed: {0}\nPrevious executable: {1}\nPrevious sources preserved: {2}\nActive sources: {3}",
+				version,
+				backup,
+				metadata.repoRoot,
+				candidate,
+			),
+		);
+	} finally {
+		await lock.release();
+	}
+}
+
+if (import.meta.main) {
+	try {
+		await initializeI18n();
+		await updateLocalized(process.argv.slice(2));
+	} catch (error) {
+		console.error(
+			__ompTranslate(
+				"Localized update failed: {0}. The Korean installation was retained; no official English version was installed.",
+				error instanceof Error ? error.message : String(error),
+			),
+		);
+		process.exitCode = 1;
+	}
+}
