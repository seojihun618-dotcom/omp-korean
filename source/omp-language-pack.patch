new file mode 100644
index 0000000..e94194a
--- /dev/null
+++ b/packages/coding-agent/src/cli/localized-update.ts
@@ -0,0 +1,123 @@
+import * as fs from "node:fs/promises";
+import * as path from "node:path";
+
+const LOCALIZED_BUILD = true;
+
+export function compareStableVersions(left: string, right: string): number {
+	const a = left.split(".").map(Number);
+	const b = right.split(".").map(Number);
+	for (let index = 0; index < 3; index++) {
+		if (a[index] !== b[index]) return a[index] < b[index] ? -1 : 1;
+	}
+	return 0;
+}
+
+export async function latestLocalizedVersion(): Promise<string> {
+	const response = await fetch("https://api.github.com/repos/can1357/oh-my-pi/releases/latest", {
+		headers: { accept: "application/vnd.github+json", "user-agent": "omp-localized-source-updater" },
+		signal: AbortSignal.timeout(30_000),
+	});
+	if (!response.ok) throw new Error(`Release check failed: HTTP ${response.status}`);
+	const release = (await response.json()) as { tag_name?: unknown };
+	const version = typeof release.tag_name === "string" ? release.tag_name.replace(/^v/, "") : "";
+	if (!/^\d+\.\d+\.\d+$/.test(version)) throw new Error("Latest release has no stable version tag");
+	return version;
+}
+
+export async function runLocalizedUpdate(
+	opts: { force: boolean; check: boolean; channel?: string },
+	installedVersion: string,
+): Promise<boolean> {
+	const directory = path.dirname(process.execPath);
+	const sourceMetadataPath = path.join(directory, "omp-localized.json");
+	const portableMetadataPath = path.join(directory, "omp-portable-update.json");
+	const metadataPath = (await Bun.file(sourceMetadataPath).exists()) ? sourceMetadataPath : portableMetadataPath;
+	const kit = path.join(directory, "update");
+	const hasMetadata = await Bun.file(metadataPath).exists();
+	if (!hasMetadata && !LOCALIZED_BUILD && !(await Bun.file(path.join(kit, "reference.json")).exists())) return false;
+	if (opts.channel === "canary")
+		throw new Error("Localized updates support stable releases only; --canary is not supported.");
+	let metadata: { schemaVersion?: number; executablePath?: string; bunPath?: string; repoRoot?: string } | undefined;
+	if (hasMetadata) {
+		metadata = JSON.parse(await fs.readFile(metadataPath, "utf8"));
+		if (
+			metadata?.schemaVersion !== 1 ||
+			typeof metadata.executablePath !== "string" ||
+			!path.isAbsolute(metadata.executablePath) ||
+			(await fs.realpath(metadata.executablePath)) !== (await fs.realpath(process.execPath))
+		) {
+			throw new Error(`Invalid localized installation metadata: ${metadataPath}`);
+		}
+	}
+	// A release check must not provision tools, create metadata or touch the installation.
+	if (opts.check) {
+		const version = await latestLocalizedVersion();
+		console.log(`Localized installed version: ${installedVersion}; upstream stable: ${version}`);
+		if (compareStableVersions(version, installedVersion) <= 0)
+			console.log("Localized installation is already up to date.");
+		return true;
+	}
+	const hasKit = await Bun.file(path.join(kit, "reference.json")).exists();
+	let runtime: string;
+	let updater: string;
+	if (hasKit) {
+		runtime = path.join(kit, process.platform === "win32" ? "bun.exe" : "bun");
+		updater = path.join(kit, "update-localized.js");
+		for (const required of [
+			runtime,
+			updater,
+			...["build-localized.ts", "update-localized.ts", "reapply-localization.ts", "localized-update.ts"].map(name =>
+				path.join(kit, "scripts", name),
+			),
+		]) {
+			if (!(await Bun.file(required).exists()))
+				throw new Error(
+					`Localized update kit is incomplete: ${required}. Keeping the current Korean installation; restore the update folder from the Korean release.`,
+				);
+		}
+	} else {
+		if (
+			!metadata ||
+			typeof metadata.bunPath !== "string" ||
+			!path.isAbsolute(metadata.bunPath) ||
+			typeof metadata.repoRoot !== "string" ||
+			!path.isAbsolute(metadata.repoRoot)
+		) {
+			throw new Error(
+				"Localized update kit is missing. Keeping the current Korean installation; restore the update folder from the Korean release.",
+			);
+		}
+		runtime = metadata.bunPath;
+		const bundled = path.join(metadata.repoRoot, "scripts", "update-localized.js");
+		updater = (await Bun.file(bundled).exists())
+			? bundled
+			: path.join(metadata.repoRoot, "scripts", "update-localized.ts");
+		for (const required of [runtime, updater]) {
+			if (!(await Bun.file(required).exists()))
+				throw new Error(`Localized update tool is missing: ${required}. Keeping the current Korean installation.`);
+		}
+	}
+	const args = [
+		runtime,
+		updater,
+		...(hasKit ? ["--kit", kit] : []),
+		...(hasMetadata
+			? ["--metadata", metadataPath]
+			: ["--portable-executable", process.execPath, "--installed-version", installedVersion]),
+		...(opts.force ? ["--force"] : []),
+	];
+	try {
+		const child = Bun.spawn(args, { stdin: "inherit", stdout: "inherit", stderr: "inherit" });
+		const code = await child.exited;
+		if (code !== 0)
+			throw new Error(
+				`Localized source update failed (exit ${code}). The Korean installation was retained; no official English version was installed.`,
+			);
+	} catch (error) {
+		throw new Error(
+			`Could not complete the localized update: ${error instanceof Error ? error.message : String(error)}`,
+			{ cause: error },
+		);
+	}
+	return true;
+}
