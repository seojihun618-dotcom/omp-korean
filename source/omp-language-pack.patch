+import { expect, test } from "bun:test";
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+
+for (const mode of ["default", "relative", "absolute"] as const) {
+	test(`exports preserved session content to a ${mode} output path`, () => {
+		const root = mkdtempSync(join(tmpdir(), "omp-export-path-"));
+		try {
+			const input = join(root, "session.jsonl");
+			const session = [
+				{ type: "session", version: 3, id: "export-path", timestamp: "2026-01-01T00:00:00.000Z", cwd: root },
+				{
+					type: "message",
+					id: "user-1",
+					parentId: null,
+					timestamp: "2026-01-01T00:00:01.000Z",
+					message: {
+						role: "user",
+						content: [{ type: "text", text: "USER_EXPORT_CONTENT_한국어" }],
+						timestamp: 1767225601000,
+					},
+				},
+			];
+			writeFileSync(input, session.map(entry => JSON.stringify(entry)).join("\n") + "\n");
+			const destination =
+				mode === "default"
+					? "omp-session-session.html"
+					: mode === "relative"
+						? "nested/output.html"
+						: join(root, "absolute/output.html");
+			const agent = join(root, "agent");
+			mkdirSync(agent);
+			const result = Bun.spawnSync(
+				[
+					process.execPath,
+					resolve(import.meta.dir, "../src/cli.ts"),
+					"--export",
+					input,
+					...(mode === "default" ? [] : [destination]),
+				],
+				{
+					cwd: root,
+					env: {
+						...process.env,
+						OMP_LANG: "en",
+						PI_PROFILE: undefined,
+						PI_CODING_AGENT_DIR: agent,
+						PI_NATIVES_DIR: join(root, "natives"),
+					},
+				},
+			);
+			expect(result.exitCode).toBe(0);
+			const html = readFileSync(resolve(root, destination), "utf8");
+			const payload = /<script[^>]*id="session-data"[^>]*>([\s\S]*?)<\/script>/.exec(html)?.[1];
+			const data = JSON.parse(Buffer.from(payload ?? "", "base64").toString("utf8"));
+			expect(data.entries.find((entry: { id: string }) => entry.id === "user-1").message.content).toEqual([
+				{ type: "text", text: "USER_EXPORT_CONTENT_한국어" },
+			]);
+		} finally {
+			rmSync(root, { recursive: true, force: true });
+		}
+	}, 30_000);
+}
