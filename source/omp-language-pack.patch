+#!/usr/bin/env bun
+import { execFileSync } from "node:child_process";
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { parseArgs } from "node:util";
+import { structuredPatch } from "diff";
+import { Node, Project, SyntaxKind, ts } from "ts-morph";
+
+const I18N = "@oh-my-pi/pi-utils/i18n";
+const MODULES = new Set([I18N, `${I18N}-browser`]);
+const RUNTIME_FILES = [
+	"packages/utils/src/i18n.ts",
+	"packages/utils/src/i18n-core.ts",
+	"packages/utils/src/i18n-browser.ts",
+	"packages/utils/src/browser-i18n.ts",
+	"packages/utils/src/locales/en.json",
+	"packages/utils/src/locales/ko.json",
+	"packages/coding-agent/src/slash-commands/builtin-language.ts",
+	"packages/collab-web/scripts/language-html.ts",
+] as const;
+
+type Literal = ts.StringLiteral | ts.NoSubstitutionTemplateLiteral | ts.TemplateExpression | ts.JsxText;
+interface Site {
+	file: string;
+	original: string;
+	context: string;
+	frame: string;
+	key: string;
+	/** Original interpolation index for each translated argument. */
+	order: number[];
+	module: string;
+}
+
+interface StructuralPatch {
+	file: string;
+	hunks: { before: string; after: string }[];
+	translatedCalls: number;
+}
+
+// These reviewed entrypoints and UI assets need more than string substitution.
+function structuralFile(file: string): boolean {
+	return (
+		file === "packages/coding-agent/src/cli/command-help.ts" ||
+		file === "packages/coding-agent/src/cli/help-extra.ts" ||
+		file === "packages/coding-agent/src/cli/setup-cli.ts" ||
+		file === "packages/coding-agent/src/daemon/client.ts" ||
+		file === "packages/coding-agent/src/config/settings-ui.ts" ||
+		file === "packages/utils/src/cli.ts" ||
+		file === "packages/utils/src/dates.ts" ||
+		file === "packages/tui/src/prompt/welcome.ts" ||
+		file === "packages/tui/src/html-form/dialog.ts" ||
+		file === "packages/tui/src/tools/ask.ts" ||
+		file === "packages/coding-agent/src/tools/ask.ts" ||
+		/^packages\/tui\/src\/(?:native\/overlay|components\/settings-list|setup\/(?:wizard-overlay|scenes\/(?:sign-in|model))|overlays\/(?:annotation-overlay|copy-selector|ask-dialog))\.ts$/.test(
+			file,
+		) ||
+		file === "packages/stats/src/index.ts" ||
+		file === "packages/stats/src/server.ts" ||
+		file === "packages/coding-agent/src/export/html/index.ts" ||
+		file === "packages/collab-web/package.json" ||
+		file === "packages/collab-web/scripts/build-export-viewer.ts" ||
+		/^packages\/(?:collab-web\/(?:src|tool-render)|stats\/src\/client)\/.*\.tsx?$/.test(file) ||
+		/^packages\/coding-agent\/src\/export\/html\/(?:template\.html(?:\.txt)?|template\.(?:js|css)|shell\.html|share-loader\.js)$/.test(
+			file,
+		)
+	);
+}
+
+function structuralGroup(file: string): string {
+	if (
+		file === "packages/collab-web/scripts/build-export-viewer.ts" ||
+		/^packages\/collab-web\/src\/export[^/]*\.tsx?$/.test(file)
+	)
+		return "html-export";
+	if (file.startsWith("packages/stats/") || file === "packages/utils/src/dates.ts") return "stats";
+	if (file.startsWith("packages/collab-web/")) return "collab";
+	if (file.startsWith("packages/coding-agent/src/export/html/")) return "html-export";
+	return file;
+}
+
+/** Self-contained localization runtime and reviewed call sites, without old checkout paths or Git dependencies. */
+export interface LocalizationReference {
+	schemaVersion: 2;
+	sites: Site[];
+	structures: StructuralPatch[];
+	runtime: Record<string, string>;
+	stats: { translatedCalls: number; retainedCalls: number; skippedCalls: number };
+}
+
+function parse(file: string, source: string): ts.SourceFile {
+	return ts.createSourceFile(
+		file,
+		source,
+		ts.ScriptTarget.Latest,
+		true,
+		file.endsWith(".tsx") ? ts.ScriptKind.TSX : ts.ScriptKind.TS,
+	);
+}
+
+function nodes(ast: ts.Node): ts.Node[] {
+	const result: ts.Node[] = [];
+	function visit(node: ts.Node): void {
+		result.push(node);
+		ts.forEachChild(node, visit);
+	}
+	visit(ast);
+	return result;
+}
+
+function plainJsxText(node: ts.Node): node is ts.JsxText {
+	// Skip entity decoding and JSX whitespace folding rather than changing rendered text.
+	return ts.isJsxText(node) && node.text.length > 0 && node.text === node.text.trim() && !/[&\r\n\t]/.test(node.text);
+}
+
+function literal(node: ts.Node): node is Literal {
+	return (
+		ts.isStringLiteral(node) ||
+		ts.isNoSubstitutionTemplateLiteral(node) ||
+		ts.isTemplateExpression(node) ||
+		plainJsxText(node)
+	);
+}
+
+function imports(ast: ts.SourceFile): Map<string, string> {
+	const bindings = new Map<string, string>();
+	for (const statement of ast.statements) {
+		if (
+			!ts.isImportDeclaration(statement) ||
+			!ts.isStringLiteral(statement.moduleSpecifier) ||
+			!MODULES.has(statement.moduleSpecifier.text) ||
+			statement.importClause?.isTypeOnly
+		)
+			continue;
+		const named = statement.importClause?.namedBindings;
+		if (!named || !ts.isNamedImports(named)) continue;
+		for (const binding of named.elements) {
+			if (!binding.isTypeOnly && (binding.propertyName ?? binding.name).text === "t")
+				bindings.set(binding.name.text, statement.moduleSpecifier.text);
+		}
+	}
+	// Without a type checker, conservatively reject aliases shadowed anywhere in the file.
+	for (const node of nodes(ast)) {
+		if (
+			(ts.isVariableDeclaration(node) ||
+				ts.isParameter(node) ||
+				ts.isBindingElement(node) ||
+				ts.isFunctionDeclaration(node) ||
+				ts.isClassDeclaration(node)) &&
+			node.name &&
+			ts.isIdentifier(node.name)
+		)
+			bindings.delete(node.name.text);
+	}
+	return bindings;
+}
+
+function translated(node: ts.Node, bindings: Map<string, string>): node is ts.CallExpression {
+	return (
+		ts.isCallExpression(node) &&
+		ts.isIdentifier(node.expression) &&
+		bindings.has(node.expression.text) &&
+		!!node.arguments[0] &&
+		ts.isStringLiteral(node.arguments[0])
+	);
+}
+
+function argumentExpression(node: ts.Expression): ts.Expression | undefined {
+	// The reviewed extractor stringifies each interpolation just as an ordinary template does.
+	if (
+		ts.isTemplateExpression(node) &&
+		node.head.text === "" &&
+		node.templateSpans.length === 1 &&
+		node.templateSpans[0].literal.text === ""
+	)
+		return node.templateSpans[0].expression;
+	return undefined;
+}
+
+function expansion(
+	call: ts.CallExpression,
+): { chunks: string[]; values: ts.Expression[]; order: number[] } | undefined {
+	const key = (call.arguments[0] as ts.StringLiteral).text.split("\u0004", 1)[0];
+	if (call.arguments.length === 1) return { chunks: [key], values: [], order: [] };
+	const values = call.arguments.slice(1).map(argumentExpression);
+	if (values.some(value => value === undefined)) return undefined;
+	const chunks: string[] = [];
+	const indexes: number[] = [];
+	let end = 0;
+	for (const match of key.matchAll(/\{(\d+)\}/g)) {
+		chunks.push(key.slice(end, match.index));
+		indexes.push(Number(match[1]));
+		end = match.index! + match[0].length;
+	}
+	chunks.push(key.slice(end));
+	// A bijection is essential: never omit, duplicate, or reorder evaluation of old expressions.
+	if (
