+import { describe, expect, it } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import { acquireLocalizedUpdateLock, updateLocalized } from "./update-localized";
+
+const updaterModule = new URL("./update-localized.ts", import.meta.url).href;
+const supportedHost =
+	(process.platform === "win32" && process.arch === "x64") ||
+	(process.platform === "darwin" && (process.arch === "arm64" || process.arch === "x64"));
+type LockOwner = Bun.Subprocess<"pipe", "pipe", "pipe">;
+
+function spawnOwner(metadataPath: string, legacy = false): LockOwner {
+	const acquire = legacy
+		? `await fs.writeFile(${JSON.stringify(`${metadataPath}.update-lock`)}, String(process.pid), { flag: "wx" });`
+		: `const lock = await acquireLocalizedUpdateLock(${JSON.stringify(metadataPath)});`;
+	return Bun.spawn(
+		[
+			process.execPath,
+			"-e",
+			`import * as fs from "node:fs/promises";
+import { acquireLocalizedUpdateLock } from ${JSON.stringify(updaterModule)};
+try {
+	${acquire}
+	await Bun.write(Bun.stdout, "held");
+	await Bun.stdin.text();
+	${legacy ? "" : "await lock.release();"}
+} catch (error) {
+	console.error(error);
+	await Bun.write(Bun.stdout, "blocked");
+	process.exitCode = 1;
+}`,
+		],
+		{ stdin: "pipe", stdout: "pipe", stderr: "pipe" },
+	);
+}
+
+async function readStatus(owner: LockOwner): Promise<string> {
+	const reader = owner.stdout.getReader();
+	try {
+		const result = await reader.read();
+		return new TextDecoder().decode(result.value);
+	} finally {
+		reader.releaseLock();
+	}
+}
+
+async function stopOwners(owners: LockOwner[]): Promise<void> {
+	for (const owner of owners) {
+		if (owner.exitCode === null) owner.kill();
+	}
+	await Promise.all(owners.map(owner => owner.exited));
+}
+
+describe("localized updater process locks", () => {
+	it.skipIf(!supportedHost)(
+		"recovers an exited legacy PID and reaches source preparation without changing the install",
+		async () => {
+			const directory = await fs.mkdtemp(path.join(os.tmpdir(), "omp-update-stale-pid-"));
+			const metadataPath = path.join(directory, "omp-localized.json");
+			const executablePath = path.join(directory, process.platform === "win32" ? "omp.exe" : "omp");
+			const owner = spawnOwner(metadataPath, true);
+			try {
+				expect(await readStatus(owner)).toBe("held");
+				owner.kill();
+				await owner.exited;
+				await fs.writeFile(executablePath, "preserved Korean executable");
+				const metadata = JSON.stringify({
+					schemaVersion: 1,
+					repoRoot: directory,
+					bunPath: process.execPath,
+					executablePath,
+					localeDir: path.join(directory, "locales"),
+					version: "18.18.2",
+				});
+				await fs.writeFile(metadataPath, metadata);
+				await expect(
+					updateLocalized(["--metadata", metadataPath, "--version", "18.18.3", "--offline"]),
+				).rejects.toThrow("Missing translation reference");
+				expect(await fs.readFile(executablePath, "utf8")).toBe("preserved Korean executable");
+				expect(await fs.readFile(metadataPath, "utf8")).toBe(metadata);
+				expect(await Bun.file(`${metadataPath}.update-lock`).exists()).toBe(false);
+				expect(await fs.readdir(path.join(directory, "updates"))).toHaveLength(1);
+			} finally {
+				await stopOwners([owner]);
+				await fs.rm(directory, { recursive: true, force: true });
+			}
+		},
+		30_000,
+	);
+
+	it("does not reclaim a live legacy updater's PID file", async () => {
+		const directory = await fs.mkdtemp(path.join(os.tmpdir(), "omp-update-live-pid-"));
+		const metadataPath = path.join(directory, "omp-localized.json");
+		const owner = spawnOwner(metadataPath, true);
+		try {
